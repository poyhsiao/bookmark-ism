{
  "id": null,
  "title": "Bookmark Service Overview",
  "tags": ["bookmark", "overview"],
  "style": "dark",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate",
      "type": "stat",
      "targets": [
        {
          "expr": "rate(http_requests_total[5m])",
          "legendFormat": "{{method}} {{endpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "HTTP Response Time (95th percentile)",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "95th percentile"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.2
              },
              {
                "color": "red",
                "value": 1.0
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 3,
      "title": "HTTP Error Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(http_requests_total{status_code=~\"5..\"}[5m]) / rate(http_requests_total[5m])",
          "legendFormat": "Error Rate"
        }
      ],
      "yAxes": [
        {
          "unit": "percentunit",
          "max": 1,
          "min": 0
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 4,
      "title": "Active Connections",
      "type": "graph",
      "targets": [
        {
          "expr": "active_connections",
          "legendFormat": "Active Connections"
        },
        {
          "expr": "http_requests_in_flight",
          "legendFormat": "Requests in Flight"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      }
    },
    {
      "id": 5,
      "title": "Database Connections",
      "type": "graph",
      "targets": [
        {
          "expr": "database_connections{state=\"open\"}",
          "legendFormat": "Open"
        },
        {
          "expr": "database_connections{state=\"idle\"}",
          "legendFormat": "Idle"
        },
        {
          "expr": "database_connections{state=\"in_use\"}",
          "legendFormat": "In Use"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      }
    },
    {
      "id": 6,
      "title": "Database Query Duration",
      "type": "graph",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(database_query_duration_seconds_bucket[5m]))",
          "legendFormat": "50th percentile"
        },
        {
          "expr": "histogram_quantile(0.95, rate(database_query_duration_seconds_bucket[5m]))",
          "legendFormat": "95th percentile"
        },
        {
          "expr": "histogram_quantile(0.99, rate(database_query_duration_seconds_bucket[5m]))",
          "legendFormat": "99th percentile"
        }
      ],
      "yAxes": [
        {
          "unit": "s"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      }
    },
    {
      "id": 7,
      "title": "Redis Connections",
      "type": "graph",
      "targets": [
        {
          "expr": "redis_connections{state=\"total\"}",
          "legendFormat": "Total"
        },
        {
          "expr": "redis_connections{state=\"active\"}",
          "legendFormat": "Active"
        },
        {
          "expr": "redis_connections{state=\"idle\"}",
          "legendFormat": "Idle"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      }
    },
    {
      "id": 8,
      "title": "Go Memory Usage",
      "type": "graph",
      "targets": [
        {
          "expr": "go_memstats_alloc_bytes",
          "legendFormat": "Allocated"
        },
        {
          "expr": "go_memstats_heap_inuse_bytes",
          "legendFormat": "Heap In Use"
        },
        {
          "expr": "go_memstats_stack_inuse_bytes",
          "legendFormat": "Stack In Use"
        }
      ],
      "yAxes": [
        {
          "unit": "bytes"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      }
    },
    {
      "id": 9,
      "title": "Go Goroutines",
      "type": "graph",
      "targets": [
        {
          "expr": "go_goroutines",
          "legendFormat": "Goroutines"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      }
    },
    {
      "id": 10,
      "title": "Business Metrics",
      "type": "table",
      "targets": [
        {
          "expr": "business_metrics",
          "legendFormat": "{{metric_name}}"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {},
            "renameByName": {
              "metric_name": "Metric",
              "Value": "Count"
            }
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 40
      }
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "schemaVersion": 27,
  "version": 1,
  "links": []
}